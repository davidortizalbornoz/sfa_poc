{
  "name": "sfa-tpp-client",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente TPP de demostracion: Authorization Code + PAR + PKCE + DPoP contra Keycloak",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
