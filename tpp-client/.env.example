KEYCLOAK_BASE_URL=http://sfa.localtest.me:8080
KEYCLOAK_REALM=sfa-poc
CLIENT_ID=tpp-demo
CLIENT_SECRET=tpp-demo-secret-local-dev
REDIRECT_URI=http://localhost:3000/callback
SCOPE=openid profile email accounts:read
CALLBACK_HOST=localhost
CALLBACK_PORT=3000
# M2M (npm run m2m): client_credentials + DPoP con tpp-demo-m2m
# M2M_CLIENT_ID=tpp-demo-m2m
# M2M_CLIENT_SECRET=tpp-demo-m2m-secret-local-dev
# M2M_SCOPE=accounts:read
# Opcional: GET protegido del Resource Server (requiere RS con validacion DPoP)
# RESOURCE_SERVER_URL=http://localhost:9090/cities
# FINTECH (npm run fintech-m2m): DCR + SSA, private_key_jwt PS256 + DPoP
# Claves en clientRegistrationPolicy/client-jwks/<FINTECH_CLIENT_ID>/ (generate-client-jwks.sh)
# FINTECH_CLIENT_ID=FINTECH-A
# FINTECH_SCOPE=accounts:read
# FINTECH_KID=fintech-a-1c8c825a868d  # opcional; por defecto se lee de jwks.json
# FINTECH_PRIVATE_KEY_PATH=../clientRegistrationPolicy/client-jwks/FINTECH-A/private.pem
# FINTECH_JWKS_PATH=../clientRegistrationPolicy/client-jwks/FINTECH-A/jwks.json
# FINTECH_RESOURCE_SERVER_URL=http://localhost:9090/cities
