# Claims del Software Statement (SSA) — valores por defecto del POC
# Copia a ssa.env para personalizar (desde clientRegistrationPolicy/): cp ssa.env.example ssa.env
# Ruta alternativa: SSA_ENV=/ruta/custom.env ./scripts/generate-test-ssa.sh

# Emisor del SSA (Directorio de participantes)
SSA_ISSUER=https://directorio-qa.finanzasabiertas.cl

# Participante / software registrado
SSA_SOFTWARE_ID=FINTECH-A
SSA_ORGANISATION_ID="FINTECH-A INC"
SSA_SOFTWARE_JWKS_URI=https://fintech-a.localtest.me/.well-known/jwks.json
SSA_SOFTWARE_CLIENT_NAME="SFA POC - DCR + SSA"
SSA_SOFTWARE_VERSION=1.0.0

# URIs de redirección (separadas por coma)
SSA_REDIRECT_URIS=http://localhost:3000/callback

# kid del JWT de firma del Directorio (debe coincidir con registro_participantes/directory-jwks.json)
SSA_JWT_KID=sfa-poc-directory-1
